# =============================================================================
# DUNST CONFIGURATION - CACHYOS / IAN
# Paleta Waybar & SDDM (MesloLGS Nerd Font + Minimal Square)
# =============================================================================

[global]
    ### Display & Monitor ###
    monitor = 0
    follow = mouse
    
    ### Geometria ###
    width = (0, 360)
    height = (0, 300)
    origin = top-right
    offset = (16, 46)
    scale = 0
    notification_limit = 5

    ### Barra de Progresso ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 360
    progress_bar_corner_radius = 0
    
    ### Estilo Minimal Square & Espaçamento ###
    corner_radius = 0
    corners = all
    frame_width = 2
    gap_size = 6
    separator_height = 1
    separator_color = frame
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    transparency = 0
    indicate_hidden = yes
    sort = yes
    idle_threshold = 120

    ### Tipografia ###
    font = MesloLGS Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Ícones ###
    enable_recursive_icon_lookup = true
    icon_theme = "Adwaita"
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    ### Histórico ###
    sticky_history = yes
    history_length = 20

    ### Comportamento e Interação ###
    browser = /usr/bin/xdg-open
    always_run_script = true
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# =============================================================================
# Níveis de Urgência (Paleta Waybar)
# =============================================================================

[urgency_low]
    background = "#11111b"
    foreground = "#bac2de"
    frame_color = "#585b70"
    highlight = "#89b4fa"
    timeout = 5
    default_icon = dialog-information

[urgency_normal]
    background = "#11111b"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    highlight = "#89b4fa"
    timeout = 8
    default_icon = dialog-information

[urgency_critical]
    background = "#11111b"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"
    highlight = "#f38ba8"
    timeout = 0
    default_icon = dialog-warning

# =============================================================================
# Regras Customizadas (Agrupamento / Stack Tags)
# =============================================================================

[backlight]
    summary = "Backlight"
    set_stack_tag = "backlight"

[volume]
    summary = "Volume"
    set_stack_tag = "volume"

[music]
    summary = "*Spotify*"
    set_stack_tag = "media"
