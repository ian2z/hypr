{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "spacing": 0,

    "modules-left": [
        "custom/quickshell",
        "mpris"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "clock",
        "pulseaudio",
        "pulseaudio#microphone",
        "tray"
    ],

    "custom/quickshell": {
        "format": "",
        "on-click": "~/.config/quickshell/toggle.sh",
        "tooltip": true,
        "tooltip-format": "Painel de Controle (Quickshell)"
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },

    "mpris": {
        "player": "spotify",
        "format": "{player_icon} {artist} - {title}",
        "format-paused": "{status_icon} {artist} - {title}",
        "player-icons": {
            "default": "▶",
            "spotify": "",
            "firefox": "󰈹"
        },
        "status-icons": {
            "paused": ""
        },
        "max-length": 45,
        "interval": 1,
        "on-click": "~/.config/quickshell/toggle.sh",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a, %d/%m/%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "~/.config/quickshell/toggle.sh",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "{desc} ({volume}%)"
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": " Muted",
        "on-click": "pkill pavucontrol || pavucontrol -t 4",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "scroll-step": 5,
        "tooltip": false
    },

    "cpu": {
        "interval": 3,
        "format": " {usage}%",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "memory": {
        "interval": 5,
        "format": "󰘚 {percentage}%",
        "states": {
            "warning": 80,
            "critical": 95
        },
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB"
    },

    "custom/updates": {
        "format": "󰚰 {}",
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/check-updates.sh",
        "interval": 3600,
        "on-click": "kitty -e yay; pkill -RTMIN+8 waybar",
        "on-click-right": "pkill -RTMIN+8 waybar",
        "signal": 8,
        "tooltip": true
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8
    }
}
